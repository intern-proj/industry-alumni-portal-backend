# ==========================================
# Comprehensive Git Ignore for Polyglot Monorepo
# ==========================================

# ── Maven & Java ──
**/target/
target/
**/*.jar
**/*.war
**/*.ear
**/*.class

# ── Python & Virtual Environments ──
**/.venv/
.venv/
**/.venv*/
.venv*/
**/venv/
venv/
**/env/
env/
**/ENV/
ENV/
**/__pycache__/
__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
**/.pytest_cache/
**/.mypy_cache/
**/*.egg-info/
**/.ruff_cache/

# ── Node & Frontend ──
**/node_modules/
node_modules/
**/dist/
dist/
**/build/
build/
.npm/
.eslintcache

# ── Embedded Repositories / Submodules ──
frontend/

# ── IDEs & Editors ──
**/.idea/
.idea/
**/*.iml
**/.vscode/
.vscode/
**/.classpath
**/.project
**/.settings/

# ── Logs & Temporary Files ──
**/*.log
*.log
**/.tempmediaStorage/
**/.DS_Store
**/Thumbs.db

# ── Environment & Secrets ──
**/.env
.env
**/.env.*
!.env.example

# ── AI & Scratch ──
CLAUDE.md
